/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "door-webhook",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-09",
	"observability": {
		"enabled": true,
	},
	"upload_source_maps": true,
	"compatibility_flags": ["nodejs_compat"],
	// Public webhook events are validated in `fetch`, buffered here, then pushed
	// to the Pi (over a Cloudflare Tunnel) by the `queue` consumer. Buffering makes
	// a Pi reboot lossless: failed deliveries retry and, after max_retries, land in
	// the dead-letter queue instead of being dropped.
	"queues": {
		"producers": [
			{
				"binding": "EVENTS",
				"queue": "door-webhook-events",
			},
		],
		"consumers": [
			{
				"queue": "door-webhook-events",
				"max_batch_size": 10,
				"max_batch_timeout": 5,
				"max_retries": 5,
				"retry_delay": 30,
				"dead_letter_queue": "door-webhook-dlq",
			},
		],
	},
	// Nothing environment-specific lives in this file, so it is safe to publish.
	// The account is supplied by CLOUDFLARE_ACCOUNT_ID (.env, git-ignored), and
	// every runtime value is a secret set with `wrangler secret put`:
	// ORIGIN_URL, CIVICRM_WEBHOOK_SECRET, ORIGIN_HMAC_SECRET,
	// CF_ACCESS_CLIENT_ID, CF_ACCESS_CLIENT_SECRET. See README.md.
	// Locally those come from .dev.vars, which also types them for `wrangler types`.
}
