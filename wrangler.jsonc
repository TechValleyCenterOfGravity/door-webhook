/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "door-webhook",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-09",
	"account_id": "c1ef96411426c5bc8ef8d6a8bd8d23ea",
	"observability": {
		"enabled": true,
	},
	"upload_source_maps": true,
	"compatibility_flags": ["nodejs_compat"],
	// Public webhook events are validated in `fetch`, buffered here, then pushed
	// to the Pi (over a Cloudflare Tunnel) by the `queue` consumer. Buffering makes
	// a Pi reboot lossless: failed deliveries retry and, after max_retries, land in
	// the dead-letter queue instead of being dropped.
	"queues": {
		"producers": [
			{
				"binding": "EVENTS",
				"queue": "door-webhook-events",
			},
		],
		"consumers": [
			{
				"queue": "door-webhook-events",
				"max_batch_size": 10,
				"max_batch_timeout": 5,
				"max_retries": 5,
				"retry_delay": 30,
				"dead_letter_queue": "door-webhook-dlq",
			},
		],
	},
	// Non-secret. The Pi's tunnel origin, e.g. https://door-sync.example.org.
	// Secrets are set with `wrangler secret put` (see README): CIVICRM_WEBHOOK_SECRET,
	// ORIGIN_HMAC_SECRET, CF_ACCESS_CLIENT_ID, CF_ACCESS_CLIENT_SECRET.
	"vars": {
		"ORIGIN_URL": "https://door-sync.example.org",
	},
}
