/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "door-webhook",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-09",
	"observability": {
		"enabled": true,
	},
	"upload_source_maps": true,
	"compatibility_flags": ["nodejs_compat"],
	// Public webhook events are validated in `fetch`, buffered here, then pushed
	// to the Pi (over a Cloudflare Tunnel) by the `queue` consumer. Buffering makes
	// a Pi reboot lossless: failed deliveries retry and, after max_retries, land in
	// the dead-letter queue instead of being dropped.
	"queues": {
		"producers": [
			{
				"binding": "EVENTS",
				"queue": "door-webhook-events",
			},
		],
		"consumers": [
			{
				"queue": "door-webhook-events",
				"max_batch_size": 10,
				"max_batch_timeout": 5,
				"max_retries": 5,
				"retry_delay": 30,
				"dead_letter_queue": "door-webhook-dlq",
			},
		],
	},
	// The Pi's tunnel origin: scheme + host only, the Worker appends the path.
	// Non-secret on purpose — it is configuration, not a credential, so it stays
	// reviewable here and deploys atomically with the code that reads it. The
	// endpoint behind it is protected by the Cloudflare Access service token and
	// the HMAC, not by this hostname being unknown.
	// The account id is not pinned here; it comes from CLOUDFLARE_ACCOUNT_ID in
	// .env (git-ignored). Secrets are set with `wrangler secret put` (see README):
	// CIVICRM_WEBHOOK_SECRET, ORIGIN_HMAC_SECRET, CF_ACCESS_CLIENT_ID,
	// CF_ACCESS_CLIENT_SECRET.
	"vars": {
		"ORIGIN_URL": "https://door-sync.example.org",
	},
}
